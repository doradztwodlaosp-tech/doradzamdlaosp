[Unit]
Description=Bot EUREKA - interpretacje podatkowe (ulgi)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=UZYTKOWNIK
WorkingDirectory=KATALOG_BOTA
EnvironmentFile=KATALOG_BOTA/eureka.env
Environment=PYTHONUNBUFFERED=1
ExecStart=KATALOG_BOTA/venv/bin/python main.py
# Bieg z przerwami 15 s między zapytaniami może trwać długo — limit 6 h.
TimeoutStartSec=6h
