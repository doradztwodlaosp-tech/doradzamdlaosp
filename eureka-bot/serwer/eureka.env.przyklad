# Skopiuj jako ~/eureka-bot/eureka.env i uzupełnij. Potem: chmod 600 ~/eureka-bot/eureka.env
# Linie zaczynające się od # są ignorowane.

# Gdzie bot trzyma PDF-y, raporty i rejestr (zostaw domyślne, jeśli nie masz powodu zmieniać)
# EUREKA_BAZA=/home/TWOJ_UZYTKOWNIK/eureka-dane

# Ile dni wstecz (po dacie wydania) bot przegląda przy każdym biegu
EUREKA_OKNO_DNI=45

# --- MAIL (Gmail) ---
# Konto Gmail, z którego wychodzi raport:
EUREKA_SMTP_UZYTKOWNIK=twoj.adres@gmail.com
# HASŁO APLIKACJI (16 znaków, bez spacji) — NIE zwykłe hasło do Gmaila. Patrz INSTALACJA.md, krok 5.
EUREKA_SMTP_HASLO=
# Odbiorcy raportu, po przecinku:
EUREKA_MAIL_DO=twoj.adres@gmail.com

# --- DYSK GOOGLE (rclone) ---
# Nazwa zdalnego z `rclone config` + folder na Dysku:
EUREKA_RCLONE_CEL=gdrive:EUREKA
# Link do tego folderu (skopiuj z przeglądarki) — trafi do treści maila:
EUREKA_DRIVE_LINK=
